{
  "manifest_version": 3,
  "name": "My Little Pet",
  "version": "1.0",
  "description": "A tiny friend that lives in your browser",
  "web_accessible_resources": [
    {
      "resources": [
        "pet-idle-front.png",
        "pet-idle-left.png",
        "pet-idle-right.png",
        "pet-idle-headleft.png",
        "pet-idle-headright.png",

       "walk-left-1.png",
       "walk-left-2.png", 
       "walk-left-3.png", 
       "walk-left-4.png", 
       
       "walk-right-2.png",
        "walk-right-1.png",
        "walk-right-3.png", 
        "walk-right-4.png"

      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
